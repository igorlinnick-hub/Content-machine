<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hwc.canva-runner</string>
  <!-- Run through a LOGIN shell (zsh -lc) so the job inherits the full user
       environment (profile, PATH, keychain-adjacent context). Under a bare
       launchd env the `claude` CLI could not load the claude.ai Canva MCP
       connector, so every poller compose failed while manual runs (from a
       login shell) worked. The login shell closes that gap. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec /bin/bash "$HOME/Library/Application Support/HWC/canva-runner/run.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/igorlinnik/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/igorlinnik</string>
  </dict>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/igorlinnik/Library/Application Support/HWC/canva-runner.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igorlinnik/Library/Application Support/HWC/canva-runner.log</string>
</dict>
</plist>
